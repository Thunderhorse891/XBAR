{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "allowJs": true,
    "outDir": ".codex-test-dist",
    "rootDir": ".",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node", "vite/client"],
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] },
    "declaration": false,
    "sourceMap": false,
    "allowImportingTsExtensions": false
  },
  "include": [
    "api/_lib/packet-branding.js",
    "api/_lib/packet-branding-raster.js",
    "api/_lib/workspace-identity.js",
    "src/store/xbarStoreLogic.ts",
    "src/types/xbar.ts",
    "src/lib/salePacketDisclosure.ts",
    "src/lib/packetVerifierScript.ts",
    "src/lib/xbarRuntime.ts",
    "src/lib/xbarPhaseTwo.ts",
    "src/lib/platformConfig.ts",
    "src/lib/billingApi.ts",
    "src/lib/facebookSharing.ts",
    "src/lib/permissions.ts",
    "src/lib/cloudSyncPolicy.ts",
    "src/lib/workspaceStorage.ts",
    "src/vite-env.d.ts",
    "src/types/api-pdf.d.ts",
    "tests/**/*.ts"
  ]
}
